{
 "version": 2,
 "tool": "xm",
 "groups": [
  {
   "id": "basic",
   "label": "基础"
  },
  {
   "id": "reality",
   "label": "Reality"
  },
  {
   "id": "transport",
   "label": "传输"
  },
  {
   "id": "tls",
   "label": "TLS"
  },
  {
   "id": "tuning",
   "label": "性能与混淆"
  },
  {
   "id": "advanced",
   "label": "高级",
   "collapsed": true
  },
  {
   "id": "meta",
   "label": "备注与标签",
   "collapsed": true
  }
 ],
 "common": [
  "name",
  "address",
  "id",
  "disabled",
  "remark",
  "region",
  "purpose",
  "line",
  "tags"
 ],
 "fields": {
  "name": {
   "flag": "--name",
   "label": "名称",
   "kind": "text",
   "group": "basic",
   "placeholder": "留空使用协议默认名称"
  },
  "port": {
   "flag": "--port",
   "label": "端口",
   "kind": "number",
   "group": "basic"
  },
  "domain": {
   "flag": "--domain",
   "label": "域名",
   "kind": "text",
   "group": "basic",
   "placeholder": "node.example.com"
  },
  "address": {
   "flag": "--address",
   "label": "客户端连接地址",
   "kind": "text",
   "group": "advanced",
   "note": "留空自动使用域名或本机公网 IP"
  },
  "id": {
   "flag": "--id",
   "label": "节点 ID",
   "kind": "text",
   "group": "advanced",
   "note": "小写字母、数字、. _ -；留空自动生成"
  },
  "disabled": {
   "flag": "--disabled",
   "label": "创建后先不启用",
   "kind": "switch",
   "group": "advanced",
   "note": "不申请证书、不监听端口"
  },
  "remark": {
   "flag": "--remark",
   "label": "备注",
   "kind": "text",
   "group": "meta"
  },
  "region": {
   "flag": "--region",
   "label": "地区",
   "kind": "text",
   "group": "meta"
  },
  "purpose": {
   "flag": "--purpose",
   "label": "用途",
   "kind": "text",
   "group": "meta"
  },
  "line": {
   "flag": "--line",
   "label": "线路",
   "kind": "text",
   "group": "meta"
  },
  "tags": {
   "flag": "--tags",
   "label": "标签",
   "kind": "text",
   "group": "meta",
   "placeholder": "a,b"
  },
  "handshake_server": {
   "flag": "--handshake-server",
   "label": "握手目标（dest）",
   "kind": "text",
   "group": "reality",
   "placeholder": "留空与伪装域名相同",
   "note": "需支持 TLS 1.3 的真实网站"
  },
  "handshake_port": {
   "flag": "--handshake-port",
   "label": "握手端口",
   "kind": "number",
   "group": "reality",
   "default": 443
  },
  "masquerade": {
   "flag": "--masquerade",
   "label": "伪装网址",
   "kind": "text",
   "group": "tuning",
   "placeholder": "https://example.com",
   "note": "非代理请求会被反代到这个网站"
  },
  "security": {
   "flag": "--security",
   "label": "安全层",
   "kind": "select",
   "group": "basic"
  },
  "sni": {
   "flag": "--domain",
   "label": "伪装域名（SNI）",
   "kind": "text",
   "group": "reality",
   "placeholder": "留空使用推荐站点"
  },
  "flow": {
   "flag": "--flow",
   "label": "流控（Flow）",
   "kind": "select",
   "group": "basic",
   "required": true,
   "emit_empty": true,
   "options": [
    {
     "value": "xtls-rprx-vision",
     "label": "xtls-rprx-vision"
    },
    {
     "value": "",
     "label": "无"
    }
   ],
   "when": {
    "transport": [
     "",
     "raw"
    ]
   },
   "hidden_emit": "",
   "note": "仅 RAW(TCP) 可用"
  },
  "transport": {
   "flag": "--transport",
   "label": "传输方式",
   "kind": "select",
   "group": "transport",
   "empty_label": "RAW（TCP）",
   "options": [
    {
     "value": "ws",
     "label": "WebSocket"
    },
    {
     "value": "grpc",
     "label": "gRPC"
    },
    {
     "value": "httpupgrade",
     "label": "HTTPUpgrade"
    },
    {
     "value": "xhttp",
     "label": "XHTTP"
    },
    {
     "value": "kcp",
     "label": "mKCP"
    }
   ]
  },
  "t_path": {
   "flag": "--path",
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "placeholder": "/path",
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "xhttp"
    ]
   }
  },
  "t_host": {
   "flag": "--host",
   "label": "Host",
   "kind": "text",
   "group": "transport",
   "placeholder": "留空使用节点域名",
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "xhttp"
    ]
   }
  },
  "t_service": {
   "flag": "--service-name",
   "label": "服务名（serviceName）",
   "kind": "text",
   "group": "transport",
   "when": {
    "transport": [
     "grpc"
    ]
   }
  },
  "xhttp_mode": {
   "flag": "--xhttp-mode",
   "label": "XHTTP 模式",
   "kind": "select",
   "group": "transport",
   "options": [
    "auto",
    "packet-up",
    "stream-up",
    "stream-one"
   ],
   "when": {
    "transport": [
     "xhttp"
    ]
   }
  },
  "tls_server_name": {
   "flag": "--tls-server-name",
   "label": "SNI",
   "kind": "text",
   "group": "tls",
   "placeholder": "留空使用节点域名",
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "alpn": {
   "flag": "--alpn",
   "label": "ALPN",
   "kind": "text",
   "group": "tls",
   "placeholder": "h2,http/1.1",
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "fingerprint": {
   "flag": "--fingerprint",
   "label": "客户端指纹（uTLS）",
   "kind": "select",
   "group": "tls",
   "options": [
    "chrome",
    "firefox",
    "safari",
    "ios",
    "android",
    "edge",
    "360",
    "qq",
    "random",
    "randomized"
   ]
  },
  "packet_encoding": {
   "flag": "--packet-encoding",
   "label": "UDP 封装",
   "kind": "select",
   "group": "advanced",
   "options": [
    "xudp",
    "packetaddr",
    "none"
   ]
  },
  "vless_encryption": {
   "flag": "--vless-encryption",
   "label": "VLESS encryption",
   "kind": "text",
   "group": "advanced"
  },
  "vless_decryption": {
   "flag": "--vless-decryption",
   "label": "VLESS decryption",
   "kind": "text",
   "group": "advanced"
  },
  "fallback_dest": {
   "flag": "--fallback-dest",
   "label": "回落目标",
   "kind": "text",
   "group": "advanced",
   "placeholder": "端口 或 主机:端口",
   "note": "非代理流量转发到这里（如本机网站 8080）"
  },
  "sniffing": {
   "flag": "--sniffing",
   "label": "流量探测",
   "kind": "select",
   "group": "advanced",
   "options": [
    {
     "value": "on",
     "label": "开启"
    },
    {
     "value": "route-only",
     "label": "仅用于路由"
    },
    {
     "value": "off",
     "label": "关闭"
    }
   ]
  },
  "sniff_dest": {
   "flag": "--sniff-dest",
   "label": "探测协议",
   "kind": "text",
   "group": "advanced",
   "placeholder": "http,tls,quic",
   "when": {
    "sniffing": [
     "on",
     "route-only"
    ]
   }
  },
  "tfo": {
   "flag": "--tcp-fast-open",
   "label": "TCP Fast Open",
   "kind": "select",
   "group": "advanced",
   "options": [
    {
     "value": "true",
     "label": "开启"
    },
    {
     "value": "false",
     "label": "关闭"
    }
   ]
  },
  "proxy_protocol": {
   "flag": "--accept-proxy-protocol",
   "label": "接受 PROXY protocol",
   "kind": "select",
   "group": "advanced",
   "options": [
    {
     "value": "true",
     "label": "开启"
    },
    {
     "value": "false",
     "label": "关闭"
    }
   ],
   "note": "前面有 Nginx/HAProxy 四层转发时使用"
  },
  "listen": {
   "flag": "--listen",
   "label": "监听地址",
   "kind": "text",
   "group": "advanced",
   "placeholder": "默认 ::"
  },
  "method": {
   "flag": "--method",
   "label": "加密方法",
   "kind": "select",
   "group": "basic",
   "required": true,
   "options": [
    "2022-blake3-aes-256-gcm",
    "2022-blake3-aes-128-gcm",
    "2022-blake3-chacha20-poly1305",
    "aes-256-gcm",
    "aes-128-gcm",
    "chacha20-ietf-poly1305",
    "xchacha20-ietf-poly1305"
   ]
  },
  "ss_network": {
   "flag": "--network",
   "label": "网络",
   "kind": "select",
   "group": "basic",
   "options": [
    {
     "value": "udp",
     "label": "仅 UDP"
    }
   ],
   "empty_label": "TCP + UDP"
  },
  "obfs": {
   "flag": "--obfs",
   "label": "混淆",
   "kind": "select",
   "group": "tuning",
   "options": [
    "salamander"
   ]
  },
  "udp_idle_timeout": {
   "flag": "--udp-idle-timeout",
   "label": "UDP 空闲超时（秒）",
   "kind": "number",
   "group": "tuning",
   "placeholder": "2-600"
  },
  "quic_congestion": {
   "flag": "--quic-congestion",
   "label": "QUIC 拥塞控制",
   "kind": "select",
   "group": "tuning",
   "options": [
    "reno",
    "bbr",
    "brutal",
    "force-brutal"
   ]
  },
  "quic_idle_timeout": {
   "flag": "--quic-idle-timeout",
   "label": "QUIC 空闲超时（秒）",
   "kind": "number",
   "group": "tuning"
  },
  "quic_keepalive": {
   "flag": "--quic-keepalive",
   "label": "QUIC 保活间隔（秒）",
   "kind": "number",
   "group": "tuning"
  },
  "allow_transparent": {
   "flag": "--allow-transparent",
   "label": "允许透明代理",
   "kind": "select",
   "group": "advanced",
   "options": [
    {
     "value": "true",
     "label": "开启"
    },
    {
     "value": "false",
     "label": "关闭"
    }
   ]
  },
  "subnet": {
   "flag": "--subnet",
   "label": "子网",
   "kind": "text",
   "group": "basic",
   "placeholder": "10.x.y.0/24，留空随机"
  },
  "mtu": {
   "flag": "--mtu",
   "label": "MTU",
   "kind": "number",
   "group": "basic"
  },
  "target": {
   "flag": "--target",
   "label": "转发目标",
   "kind": "text",
   "group": "basic",
   "placeholder": "主机:端口"
  },
  "tunnel_network": {
   "flag": "--network",
   "label": "网络",
   "kind": "select",
   "group": "basic",
   "options": [
    {
     "value": "udp",
     "label": "UDP"
    },
    {
     "value": "tcp,udp",
     "label": "TCP + UDP"
    }
   ],
   "empty_label": "TCP"
  },
  "follow_redirect": {
   "flag": "--follow-redirect",
   "label": "跟随重定向（透明代理）",
   "kind": "switch",
   "group": "advanced"
  },
  "port_map": {
   "flag": "--port-map",
   "label": "端口映射",
   "kind": "text",
   "group": "advanced",
   "placeholder": "端口=主机:端口,…"
  },
  "path": {
   "flag": "--path",
   "label": "WebSocket 路径",
   "kind": "text",
   "group": "basic",
   "placeholder": "留空自动生成"
  },
  "proxy_listen": {
   "flag": "--listen",
   "label": "监听地址",
   "kind": "select",
   "group": "basic",
   "options": [
    "127.0.0.1",
    "::1",
    "0.0.0.0",
    "::"
   ],
   "empty_label": "127.0.0.1（仅本机）"
  }
 },
 "protocols": [
  {
   "type": "vless",
   "label": "VLESS",
   "note": "推荐 Reality + Vision：不需要域名和证书。",
   "fields": [
    {
     "key": "security",
     "required": true,
     "options": [
      {
       "value": "reality",
       "label": "Reality（无需证书）"
      },
      {
       "value": "tls",
       "label": "TLS（需要域名证书）"
      },
      {
       "value": "none",
       "label": "无（放在 CDN / 反代之后）"
      }
     ]
    },
    {
     "key": "domain",
     "required": true,
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    {
     "key": "sni",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_server",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_port",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "port",
     "default": 443
    },
    "flow",
    "transport",
    "t_path",
    "t_host",
    "t_service",
    "xhttp_mode",
    "tls_server_name",
    "alpn",
    "fingerprint",
    "packet_encoding",
    "fallback_dest",
    "listen",
    "sniffing",
    "sniff_dest",
    "tfo",
    "proxy_protocol",
    "vless_encryption",
    "vless_decryption"
   ]
  },
  {
   "type": "vmess",
   "label": "VMess",
   "note": "默认无 TLS；选择 TLS 时需要域名证书。",
   "fields": [
    {
     "key": "security",
     "options": [
      {
       "value": "tls",
       "label": "TLS（需要域名证书）"
      }
     ],
     "empty_label": "无"
    },
    {
     "key": "domain",
     "required": true,
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    {
     "key": "port",
     "placeholder": "留空自动选择"
    },
    "transport",
    "t_path",
    "t_host",
    "t_service",
    "xhttp_mode",
    "tls_server_name",
    "alpn",
    "fingerprint",
    "sniffing",
    "sniff_dest",
    "tfo",
    "proxy_protocol"
   ]
  },
  {
   "type": "trojan",
   "label": "Trojan",
   "note": "TLS 需要域名证书；Reality 不需要。",
   "fields": [
    {
     "key": "security",
     "required": true,
     "options": [
      {
       "value": "tls",
       "label": "TLS（需要域名证书）"
      },
      {
       "value": "reality",
       "label": "Reality（无需证书）"
      }
     ]
    },
    {
     "key": "domain",
     "required": true,
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    {
     "key": "sni",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_server",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_port",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "port",
     "default": 443
    },
    "transport",
    "t_path",
    "t_host",
    "t_service",
    "xhttp_mode",
    "tls_server_name",
    "alpn",
    "fingerprint",
    "fallback_dest",
    "sniffing",
    "sniff_dest",
    "tfo",
    "proxy_protocol"
   ]
  },
  {
   "type": "ss",
   "label": "Shadowsocks",
   "note": "密钥自动生成。",
   "fields": [
    {
     "key": "port",
     "default": 8388
    },
    "method",
    "ss_network",
    "sniffing",
    "sniff_dest",
    "tfo",
    "proxy_protocol"
   ]
  },
  {
   "type": "hy2",
   "label": "Hysteria2",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "obfs",
    "masquerade",
    "quic_congestion",
    "udp_idle_timeout",
    "quic_idle_timeout",
    "quic_keepalive"
   ]
  },
  {
   "type": "vmess-ws-cf",
   "label": "VMess + WS（Cloudflare）",
   "note": "VMess + WebSocket，配合 Cloudflare CDN 或 Tunnel 使用。",
   "fields": [
    {
     "key": "domain",
     "note": "经 Cloudflare 代理的域名"
    },
    {
     "key": "port",
     "placeholder": "留空自动选择"
    },
    "path"
   ]
  },
  {
   "type": "socks",
   "label": "SOCKS5",
   "note": "用户名和密码自动生成。",
   "fields": [
    {
     "key": "port",
     "default": 1080
    },
    "proxy_listen"
   ]
  },
  {
   "type": "http",
   "label": "HTTP",
   "note": "用户名和密码自动生成。",
   "fields": [
    {
     "key": "port",
     "default": 1080
    },
    "proxy_listen",
    "allow_transparent"
   ]
  },
  {
   "type": "mixed",
   "label": "Mixed（SOCKS5 + HTTP）",
   "note": "用户名和密码自动生成。",
   "fields": [
    {
     "key": "port",
     "default": 1080
    },
    "proxy_listen"
   ]
  },
  {
   "type": "wireguard",
   "label": "WireGuard",
   "note": "每个用户一个 peer，密钥自动生成。",
   "fields": [
    {
     "key": "port",
     "placeholder": "留空自动选择"
    },
    "subnet",
    {
     "key": "mtu",
     "default": 1420
    }
   ]
  },
  {
   "type": "masque",
   "label": "MASQUE",
   "note": "HTTP/3 connect-ip。需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "subnet",
    {
     "key": "mtu",
     "default": 1280
    }
   ]
  },
  {
   "type": "tunnel",
   "label": "端口转发",
   "note": "把本机一个端口转发到固定目标（dokodemo-door）。",
   "fields": [
    {
     "key": "port",
     "required": true
    },
    {
     "key": "target",
     "required": true
    },
    "tunnel_network",
    "follow_redirect",
    "port_map"
   ]
  }
 ]
}
