{
 "version": 3,
 "tool": "xm",
 "id_flag": "--id",
 "groups": [
  {
   "id": "basic",
   "label": ""
  },
  {
   "id": "client",
   "label": "客户端"
  },
  {
   "id": "proto",
   "label": "协议设置"
  },
  {
   "id": "transport",
   "label": "传输"
  },
  {
   "id": "security",
   "label": "安全"
  },
  {
   "id": "sniffing",
   "label": "嗅探",
   "collapsed": true
  },
  {
   "id": "advanced",
   "label": "高级",
   "collapsed": true
  }
 ],
 "common": [
  "address",
  "__id",
  "remark",
  "region",
  "tags"
 ],
 "fields": {
  "enable": {
   "label": "启用",
   "kind": "switch",
   "group": "basic",
   "top": true,
   "default": true,
   "invert": true,
   "flag": "--disabled",
   "create_only": true
  },
  "name": {
   "label": "备注",
   "kind": "text",
   "group": "basic",
   "top": true,
   "flag": "--name",
   "placeholder": "显示在分享链接里的名称",
   "from": "name"
  },
  "port": {
   "label": "端口",
   "kind": "number",
   "group": "basic",
   "flag": "--port",
   "random": [
    10000,
    60000
   ],
   "required": true,
   "from": "port"
  },
  "total": {
   "label": "总流量",
   "kind": "number",
   "group": "basic",
   "suffix": "GB",
   "placeholder": "0 或留空表示不限",
   "post": {
    "cmd": [
     "traffic",
     "set",
     "{id}"
    ],
    "flag": "--quota",
    "suffix": "G"
   },
   "pattern": "^[1-9]\\d*$",
   "pattern_hint": "填大于 0 的整数，不限制请留空",
   "create_only": true
  },
  "reset_day": {
   "label": "流量重置",
   "kind": "select",
   "group": "basic",
   "empty_label": "不重置",
   "options": [
    {
     "value": "1",
     "label": "每月 1 日"
    },
    {
     "value": "5",
     "label": "每月 5 日"
    },
    {
     "value": "10",
     "label": "每月 10 日"
    },
    {
     "value": "15",
     "label": "每月 15 日"
    },
    {
     "value": "20",
     "label": "每月 20 日"
    },
    {
     "value": "25",
     "label": "每月 25 日"
    },
    {
     "value": "28",
     "label": "每月 28 日"
    }
   ],
   "post": {
    "cmd": [
     "traffic",
     "set",
     "{id}"
    ],
    "flag": "--reset-day"
   },
   "when_filled": "total",
   "create_only": true
  },
  "expiry": {
   "label": "到期时间",
   "kind": "number",
   "group": "basic",
   "suffix": "天后",
   "placeholder": "留空表示永不过期",
   "post": {
    "cmd": [
     "node",
     "expiry",
     "{id}"
    ],
    "flag": "--days"
   },
   "pattern": "^[1-9]\\d*$",
   "pattern_hint": "填大于 0 的天数",
   "create_only": true
  },
  "uuid": {
   "label": "ID",
   "kind": "text",
   "group": "client",
   "flag": "--uuid",
   "generate": "uuid",
   "auto": true,
   "required": true,
   "create_only": true
  },
  "password": {
   "label": "密码",
   "kind": "text",
   "group": "client",
   "flag": "--password",
   "generate": "password:20",
   "auto": true,
   "required": true,
   "create_only": true
  },
  "cred_auto": {
   "label": "凭据",
   "kind": "text",
   "group": "client",
   "value": "创建时自动生成，可在「分享」里查看",
   "readonly": true,
   "create_only": true
  },
  "address": {
   "label": "客户端连接地址",
   "kind": "text",
   "group": "advanced",
   "flag": "--address",
   "placeholder": "留空自动使用域名或本机公网 IP",
   "from": "server_address"
  },
  "__id": {
   "label": "节点 ID",
   "kind": "text",
   "group": "advanced",
   "placeholder": "留空自动生成",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
   "pattern_hint": "小写字母、数字、. _ -",
   "create_only": true
  },
  "remark": {
   "label": "附注",
   "kind": "text",
   "group": "advanced",
   "flag": "--remark",
   "from": "metadata.remark"
  },
  "region": {
   "label": "地区",
   "kind": "text",
   "group": "advanced",
   "flag": "--region",
   "from": "metadata.region"
  },
  "tags": {
   "label": "标签",
   "kind": "text",
   "group": "advanced",
   "flag": "--tags",
   "placeholder": "a,b",
   "from": "metadata.tags"
  },
  "sni": {
   "label": "SNI",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "留空使用推荐站点",
   "note": "伪装成访问这个网站",
   "from": "domain"
  },
  "dest": {
   "label": "目标网站（Target）",
   "kind": "text",
   "group": "security",
   "flag": "--handshake-server",
   "placeholder": "留空与 SNI 相同",
   "note": "需支持 TLS 1.3 的真实网站",
   "from": "handshake_server"
  },
  "dest_port": {
   "label": "目标端口",
   "kind": "number",
   "group": "security",
   "flag": "--handshake-port",
   "value": 443,
   "from": "handshake_port"
  },
  "short_id": {
   "label": "Short ID",
   "kind": "text",
   "group": "security",
   "flag": "--short-id",
   "generate": "hex:8",
   "auto": true,
   "pattern": "^([0-9a-fA-F]{2}){1,8}$",
   "pattern_hint": "2-16 位十六进制，位数为偶数",
   "create_only": true
  },
  "reality_keys": {
   "label": "公钥 / 私钥",
   "kind": "text",
   "group": "security",
   "value": "创建时自动生成",
   "readonly": true,
   "create_only": true
  },
  "domain": {
   "label": "域名",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "node.example.com",
   "required": true,
   "note": "需要域名证书；没有时自动签发（DNS 服务商在「设置」里填写）。",
   "from": "domain"
  },
  "listen": {
   "label": "监听",
   "kind": "text",
   "group": "basic",
   "flag": "--listen",
   "placeholder": "留空监听所有地址",
   "from": "listen"
  },
  "proxy_listen": {
   "label": "监听",
   "kind": "select",
   "group": "basic",
   "flag": "--listen",
   "required": true,
   "options": [
    {
     "value": "127.0.0.1",
     "label": "127.0.0.1（仅本机）"
    },
    {
     "value": "0.0.0.0",
     "label": "0.0.0.0（所有 IPv4）"
    },
    {
     "value": "::",
     "label": "::（所有地址）"
    },
    {
     "value": "::1",
     "label": "::1"
    }
   ],
   "from": "listen",
   "edit": "no"
  },
  "security": {
   "label": "安全",
   "kind": "radio",
   "group": "security",
   "flag": "--security",
   "required": true,
   "from": "security",
   "edit": "no"
  },
  "flow": {
   "label": "Flow",
   "kind": "select",
   "group": "client",
   "flag": "--flow",
   "required": true,
   "emit_empty": true,
   "options": [
    {
     "value": "xtls-rprx-vision",
     "label": "xtls-rprx-vision"
    },
    {
     "value": "",
     "label": "无"
    }
   ],
   "when": {
    "transport": [
     "",
     "raw"
    ],
    "security": [
     "reality",
     "tls"
    ]
   },
   "hidden_emit": "",
   "from": "flow"
  },
  "transport": {
   "label": "传输",
   "kind": "radio",
   "group": "transport",
   "flag": "--transport",
   "empty_label": "TCP (RAW)",
   "options": [
    {
     "value": "kcp",
     "label": "mKCP"
    },
    {
     "value": "ws",
     "label": "WebSocket"
    },
    {
     "value": "grpc",
     "label": "gRPC"
    },
    {
     "value": "httpupgrade",
     "label": "HTTPUpgrade"
    },
    {
     "value": "xhttp",
     "label": "XHTTP"
    }
   ],
   "from": "xray.inbound.streamSettings.network",
   "from_map": {
    "raw": "",
    "tcp": ""
   },
   "edit_empty": "raw"
  },
  "t_host": {
   "label": "主机",
   "kind": "text",
   "group": "transport",
   "flag": "--host",
   "placeholder": "留空使用节点域名",
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "xhttp"
    ]
   },
   "from": [
    "xray.inbound.streamSettings.wsSettings.host",
    "xray.inbound.streamSettings.wsSettings.headers.Host",
    "xray.inbound.streamSettings.httpupgradeSettings.host",
    "xray.inbound.streamSettings.xhttpSettings.host"
   ]
  },
  "t_path": {
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "flag": "--path",
   "value": "/",
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "xhttp"
    ]
   },
   "from": [
    "xray.inbound.streamSettings.wsSettings.path",
    "xray.inbound.streamSettings.httpupgradeSettings.path",
    "xray.inbound.streamSettings.xhttpSettings.path"
   ]
  },
  "t_service": {
   "label": "服务名称",
   "kind": "text",
   "group": "transport",
   "flag": "--service-name",
   "when": {
    "transport": [
     "grpc"
    ]
   },
   "from": "xray.inbound.streamSettings.grpcSettings.serviceName"
  },
  "xhttp_mode": {
   "label": "模式",
   "kind": "select",
   "group": "transport",
   "flag": "--xhttp-mode",
   "options": [
    "auto",
    "packet-up",
    "stream-up",
    "stream-one"
   ],
   "when": {
    "transport": [
     "xhttp"
    ]
   },
   "from": "xray.inbound.streamSettings.xhttpSettings.mode"
  },
  "proxy_protocol": {
   "label": "Proxy Protocol",
   "kind": "select",
   "group": "transport",
   "flag": "--accept-proxy-protocol",
   "empty_label": "关闭",
   "options": [
    {
     "value": "true",
     "label": "开启"
    }
   ],
   "from": "xray.inbound.streamSettings.sockopt.acceptProxyProtocol",
   "edit_empty": "false"
  },
  "utls": {
   "label": "uTLS",
   "kind": "select",
   "group": "security",
   "flag": "--fingerprint",
   "options": [
    "chrome",
    "firefox",
    "safari",
    "ios",
    "android",
    "edge",
    "360",
    "qq",
    "random",
    "randomized"
   ],
   "empty_label": "chrome（默认）",
   "when": {
    "security": [
     "tls",
     "reality"
    ]
   },
   "from": [
    "xray.outbound.streamSettings.tlsSettings.fingerprint",
    "xray.outbound.streamSettings.realitySettings.fingerprint"
   ]
  },
  "alpn": {
   "label": "ALPN",
   "kind": "tags",
   "group": "security",
   "flag": "--alpn",
   "options": [
    "h3",
    "h2",
    "http/1.1"
   ],
   "when": {
    "security": [
     "tls"
    ]
   },
   "from": "xray.inbound.streamSettings.tlsSettings.alpn"
  },
  "tls_sni": {
   "label": "SNI",
   "kind": "text",
   "group": "security",
   "flag": "--tls-server-name",
   "placeholder": "留空使用域名",
   "when": {
    "security": [
     "tls"
    ]
   },
   "from": "xray.outbound.streamSettings.tlsSettings.serverName"
  },
  "sniffing": {
   "label": "嗅探",
   "kind": "radio",
   "group": "sniffing",
   "flag": "--sniffing",
   "empty_label": "默认",
   "options": [
    {
     "value": "on",
     "label": "开启"
    },
    {
     "value": "route-only",
     "label": "仅用于路由"
    },
    {
     "value": "off",
     "label": "关闭"
    }
   ]
  },
  "sniff_dest": {
   "label": "嗅探协议",
   "kind": "tags",
   "group": "sniffing",
   "flag": "--sniff-dest",
   "options": [
    {
     "value": "http",
     "label": "HTTP"
    },
    {
     "value": "tls",
     "label": "TLS"
    },
    {
     "value": "quic",
     "label": "QUIC"
    },
    {
     "value": "fakedns",
     "label": "FAKEDNS"
    }
   ],
   "when": {
    "sniffing": [
     "on",
     "route-only"
    ]
   },
   "from": "xray.inbound.sniffing.destOverride"
  },
  "tfo": {
   "label": "TCP Fast Open",
   "kind": "select",
   "group": "advanced",
   "flag": "--tcp-fast-open",
   "empty_label": "默认",
   "options": [
    {
     "value": "true",
     "label": "开启"
    },
    {
     "value": "false",
     "label": "关闭"
    }
   ],
   "from": "xray.inbound.streamSettings.sockopt.tcpFastOpen",
   "edit_empty": "false"
  },
  "packet_encoding": {
   "label": "UDP 封装",
   "kind": "select",
   "group": "advanced",
   "flag": "--packet-encoding",
   "options": [
    "xudp",
    "packetaddr",
    "none"
   ],
   "from": "xray.packet_encoding"
  },
  "fallback_dest": {
   "label": "回落目标",
   "kind": "text",
   "group": "advanced",
   "flag": "--fallback-dest",
   "placeholder": "端口 或 主机:端口",
   "note": "非代理流量转发到这里（如本机网站 8080）",
   "edit_empty": "none"
  },
  "method": {
   "label": "加密方式",
   "kind": "select",
   "group": "proto",
   "flag": "--method",
   "required": true,
   "options": [
    "2022-blake3-aes-256-gcm",
    "2022-blake3-aes-128-gcm",
    "2022-blake3-chacha20-poly1305",
    "aes-256-gcm",
    "aes-128-gcm",
    "chacha20-ietf-poly1305",
    "xchacha20-ietf-poly1305"
   ],
   "from": "method"
  },
  "ss_network": {
   "label": "网络",
   "kind": "radio",
   "group": "proto",
   "flag": "--network",
   "empty_label": "TCP + UDP",
   "options": [
    {
     "value": "udp",
     "label": "仅 UDP"
    }
   ],
   "edit": "no"
  },
  "obfs": {
   "label": "混淆",
   "kind": "radio",
   "group": "proto",
   "flag": "--obfs",
   "empty_label": "无",
   "options": [
    {
     "value": "salamander",
     "label": "Salamander"
    }
   ],
   "from": "obfs.type",
   "from_map": {
    "none": ""
   },
   "edit_empty": "none"
  },
  "masquerade": {
   "label": "伪装网址",
   "kind": "text",
   "group": "proto",
   "flag": "--masquerade",
   "placeholder": "https://example.com",
   "from": "masquerade"
  },
  "quic_congestion": {
   "label": "拥塞控制",
   "kind": "select",
   "group": "proto",
   "flag": "--quic-congestion",
   "options": [
    "reno",
    "bbr",
    "brutal",
    "force-brutal"
   ],
   "edit": "no"
  },
  "udp_idle": {
   "label": "UDP 空闲超时",
   "kind": "number",
   "group": "proto",
   "flag": "--udp-idle-timeout",
   "suffix": "秒",
   "placeholder": "2-600",
   "edit": "no"
  },
  "allow_transparent": {
   "label": "允许透明代理",
   "kind": "select",
   "group": "proto",
   "flag": "--allow-transparent",
   "empty_label": "关闭",
   "options": [
    {
     "value": "true",
     "label": "开启"
    }
   ],
   "edit": "no"
  },
  "subnet": {
   "label": "子网",
   "kind": "text",
   "group": "proto",
   "flag": "--subnet",
   "placeholder": "10.x.y.0/24，留空随机",
   "from": "subnet",
   "edit": "no"
  },
  "mtu": {
   "label": "MTU",
   "kind": "number",
   "group": "proto",
   "flag": "--mtu",
   "from": "mtu",
   "edit": "no"
  },
  "target": {
   "label": "目标地址",
   "kind": "text",
   "group": "proto",
   "flag": "--target",
   "placeholder": "主机:端口",
   "required": true,
   "from": "target",
   "edit": "no"
  },
  "tunnel_network": {
   "label": "网络",
   "kind": "radio",
   "group": "proto",
   "flag": "--network",
   "empty_label": "TCP",
   "options": [
    {
     "value": "udp",
     "label": "UDP"
    },
    {
     "value": "tcp,udp",
     "label": "TCP + UDP"
    }
   ],
   "edit": "no"
  },
  "follow_redirect": {
   "label": "跟随重定向",
   "kind": "switch",
   "group": "proto",
   "flag": "--follow-redirect",
   "edit": "no"
  },
  "ws_path": {
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "flag": "--path",
   "placeholder": "留空自动生成",
   "from": "ws_path"
  },
  "cf_domain": {
   "label": "域名",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "经 Cloudflare 代理的域名",
   "from": "domain"
  }
 },
 "protocols": [
  {
   "type": "vless",
   "label": "VLESS",
   "fields": [
    "enable",
    "name",
    "listen",
    {
     "key": "port",
     "value": 443
    },
    "total",
    "reset_day",
    "expiry",
    "uuid",
    "flow",
    "transport",
    "t_host",
    "t_path",
    "t_service",
    "xhttp_mode",
    "proxy_protocol",
    {
     "key": "security",
     "options": [
      {
       "value": "reality",
       "label": "Reality"
      },
      {
       "value": "tls",
       "label": "TLS"
      },
      {
       "value": "none",
       "label": "无"
      }
     ]
    },
    {
     "key": "domain",
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    "tls_sni",
    "utls",
    "alpn",
    {
     "key": "sni",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "dest",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "dest_port",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "short_id",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "reality_keys",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    "sniffing",
    "sniff_dest",
    "tfo",
    "packet_encoding",
    "fallback_dest"
   ],
   "state": "vless"
  },
  {
   "type": "vmess",
   "label": "VMess",
   "fields": [
    "enable",
    "name",
    {
     "key": "port",
     "auto": true
    },
    "total",
    "reset_day",
    "expiry",
    "uuid",
    "transport",
    "t_host",
    "t_path",
    "t_service",
    "xhttp_mode",
    "proxy_protocol",
    {
     "key": "security",
     "options": [
      {
       "value": "none",
       "label": "无"
      },
      {
       "value": "tls",
       "label": "TLS"
      }
     ]
    },
    {
     "key": "domain",
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    "tls_sni",
    "utls",
    "alpn",
    {
     "key": "sni",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "dest",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "dest_port",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "short_id",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "reality_keys",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    "sniffing",
    "sniff_dest",
    "tfo"
   ],
   "state": "vmess"
  },
  {
   "type": "trojan",
   "label": "Trojan",
